LLM_PROVIDER=lmstudio            # lmstudio | openrouter

# LM Studio (local server; default port is usually 1234)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio       # any non-empty string
LMSTUDIO_MODEL=                  # model id currently loaded in LM Studio

# OpenRouter (hosted)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=                # model slug

MAX_STEPS=40                     # max LLM turns per user message
MAX_REPAIRS=3                    # consecutive failed-code retries
APPROVAL_SECONDS_THRESHOLD=60    # est_seconds above this needs approval
PYTHON_SOFT_TIMEOUT_S=300
