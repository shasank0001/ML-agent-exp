LLM_PROVIDER=lmstudio            # lmstudio | openrouter

# LM Studio (local server; default port is usually 1234)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio       # any non-empty string
LMSTUDIO_MODEL=                  # model id currently loaded in LM Studio

# OpenRouter (hosted)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=                # model slug

MAX_STEPS=60                     # max LLM turns per user message (ML runs need headroom)
MAX_REPAIRS=5                    # consecutive failed-code retries (timeouts don't count)
APPROVAL_SECONDS_THRESHOLD=180   # est_seconds above this needs approval
PYTHON_SOFT_TIMEOUT_S=1200       # base cell timeout; actual = max(base, est+180), cap 3600
LLM_TIMEOUT_S=600                # per-request model timeout
LLM_MAX_RETRIES=1                # client retries (agent adds step-level retry)
CONTEXT_WINDOW_MESSAGES=20       # last-N messages sent per turn
MAX_TOOL_OUTPUT_CHARS=8000       # head+tail cap for tool text in model context
RUNS_DIR=                        # override session storage dir (default <repo>/runs)
